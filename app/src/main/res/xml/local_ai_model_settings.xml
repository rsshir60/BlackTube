<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="Universal Local Model Hub">

    <!-- ══════════════════════════════════════════════════════════
         SECTION 1: Model Selection & Status
         ══════════════════════════════════════════════════════════ -->

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="🤖  Local Model Catalog"
        app:iconSpaceReserved="true">

        <ListPreference
            android:defaultValue="phi_5_1_3b"
            android:entries="@array/local_ai_model_entries"
            android:entryValues="@array/local_ai_model_values"
            android:icon="@drawable/ic_sparkles_modern"
            android:key="pref_key_active_local_model_id"
            android:summary="Select active local model for airplane-mode summaries"
            android:title="Active Local LLM Model"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_language"
            android:key="pref_key_local_ai_status"
            android:summary="Checking model installation status..."
            android:title="Engine Status"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_file_download"
            android:key="pref_key_local_ai_download"
            android:summary="Download active model from HuggingFace for offline summaries"
            android:title="Download Active Model"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <!-- ══════════════════════════════════════════════════════════
         SECTION 2: Hardware & Specs
         ══════════════════════════════════════════════════════════ -->

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="⚡  Hardware &amp; Architecture"
        app:iconSpaceReserved="true">

        <Preference
            android:icon="@drawable/ic_settings"
            android:selectable="false"
            android:summary="Phi-5 1.3B (3GB+ RAM) • Qwen 1.5B (4GB+ RAM) • Phi-4 3.8B (6GB+ RAM). Runs 100% locally via GGUF neural weights."
            android:title="Hardware Recommendation"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

    </PreferenceCategory>

</PreferenceScreen>
