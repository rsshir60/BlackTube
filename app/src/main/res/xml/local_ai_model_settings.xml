<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="Offline Local AI Engine">

    <!-- ══════════════════════════════════════════════════════════
         SECTION 1: Single Default Local Model
         ══════════════════════════════════════════════════════════ -->

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="🤖  Offline Local SLM Engine"
        app:iconSpaceReserved="true">

        <Preference
            android:icon="@drawable/ic_sparkles_modern"
            android:key="pref_key_local_ai_model_info"
            android:summary="Microsoft Phi-4 Mini 3.8B (Q4_K_M • 2.4 GB). Runs 100% locally on-device without internet."
            android:title="Model: Phi-4 Mini 3.8B"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_language"
            android:key="pref_key_local_ai_status"
            android:summary="Checking model installation status..."
            android:title="Engine Status"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_file_download"
            android:key="pref_key_local_ai_download"
            android:summary="Download Phi-4 Mini from HuggingFace for 100% offline summaries"
            android:title="Download Offline Model (2.4 GB)"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <!-- ══════════════════════════════════════════════════════════
         SECTION 2: Hardware & Privacy
         ══════════════════════════════════════════════════════════ -->

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="🔒  Privacy &amp; System Demands"
        app:iconSpaceReserved="true">

        <Preference
            android:icon="@drawable/ic_settings"
            android:selectable="false"
            android:summary="Requires 4GB+ device RAM. Zero network requests during inference. All processing runs directly on your CPU/GPU neural cores."
            android:title="Hardware &amp; Zero-Telemetry"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

    </PreferenceCategory>

</PreferenceScreen>
