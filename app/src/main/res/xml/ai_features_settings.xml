<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:key="ai_features_preferences"
    android:title="@string/ai_features_title">

    <!-- ══════════════════════════════════════════════════════════
         SECTION 0: AI Status Header (custom inflated card)
         ══════════════════════════════════════════════════════════ -->

    <Preference
        android:key="ai_status_header"
        android:layout="@layout/preference_ai_status_header"
        android:selectable="false" />

    <!-- ══════════════════════════════════════════════════════════
         SECTION 1: AI Summary Master Controls
         ══════════════════════════════════════════════════════════ -->

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="✨  AI Summary System"
        app:iconSpaceReserved="true">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/ic_auto_awesome"
            android:key="@string/gemini_enable_key"
            android:summary="Enable AI video summaries, chapter insights, and Q&amp;A"
            android:title="Enable AI Summaries"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <!-- ══════════════════════════════════════════════════════════
         SECTION 2: Cloud Engine (Google Gemini)
         ══════════════════════════════════════════════════════════ -->

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="☁️  Google Gemini AI Engine"
        app:iconSpaceReserved="true">

        <EditTextPreference
            android:icon="@drawable/ic_vpn_key"
            android:key="@string/gemini_api_key_key"
            android:summary="Enter your Gemini API key for fast cloud summaries"
            android:title="Gemini API Key"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

        <Preference
            android:key="ai_connection_status"
            android:layout="@layout/preference_ai_connection_status"
            android:selectable="false" />

        <Preference
            android:icon="@drawable/ic_lock"
            android:key="pref_key_ai_privacy_footnote"
            android:selectable="false"
            android:summary="Your API key never leaves this device. Requests go directly from your phone to Google AI Studio — no BlackTube servers exist in between."
            android:title="Privacy &amp; Data Security"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <!-- ══════════════════════════════════════════════════════════
         SECTION 4: Prompt System & Storage
         ══════════════════════════════════════════════════════════ -->

    <PreferenceCategory
        android:layout="@layout/settings_category_header_layout"
        android:title="📚  Prompts &amp; Cache Storage"
        app:iconSpaceReserved="true">

        <Preference
            android:key="ai_active_prompt_display"
            android:layout="@layout/preference_ai_active_prompt"
            android:selectable="false" />

        <Preference
            android:icon="@drawable/ic_tune"
            android:key="@string/prompt_library_key"
            android:summary="Customize AI summary templates and tone presets"
            android:title="Prompt Library"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_delete"
            android:key="@string/clear_ai_cache_key"
            android:summary="Clear all cached summary outputs from local storage"
            android:title="Clear AI Summary Cache"
            app:iconSpaceReserved="true"
            app:singleLineTitle="false" />

    </PreferenceCategory>

</PreferenceScreen>
