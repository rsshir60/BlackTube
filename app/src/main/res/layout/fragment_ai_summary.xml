<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ai_summary_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/windowBackground"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER CARD / TITLE (8dp grid aligned) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_auto_awesome"
                app:tint="?attr/colorAccent"
                android:contentDescription="@string/summary_title"
                android:layout_marginEnd="8dp" />

            <org.schabi.newpipe.views.NewPipeTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/summary_title"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>

        <!-- STATE LAYOUTS -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- CONFIGURATION NEEDED STATE -->
            <LinearLayout
                android:id="@+id/state_no_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center"
                android:paddingVertical="24dp"
                android:visibility="gone"
                tools:visibility="gone">

                <org.schabi.newpipe.views.NewPipeTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gemini_not_configured"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_open_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_bt_ai_action_button"
                    android:paddingHorizontal="24dp"
                    android:text="@string/settings"
                    android:textAllCaps="false"
                    android:textColor="@color/bt_ai_button_text_selector"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- READY TO SUMMARIZE STATE -->
            <LinearLayout
                android:id="@+id/state_ready"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="16dp"
                android:visibility="visible"
                tools:visibility="visible">

                <!-- Active prompt & Engine Selector chips -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/chip_active_prompt"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_bt_ai_prompt_chip"
                        android:drawableStart="@drawable/ic_tune"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/bt_switch_on_color"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="16dp"
                        android:text="@string/prompt_library_default"
                        android:textAllCaps="false"
                        android:textColor="@color/bt_ai_button_text_selector"
                        android:textSize="12sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/chip_engine_selector"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_bt_ai_prompt_chip"
                        android:drawableStart="@drawable/ic_settings"
                        android:drawablePadding="6dp"
                        android:drawableTint="?attr/colorAccent"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="16dp"
                        android:text="✨ Auto ▾"
                        android:textAllCaps="false"
                        android:textColor="@color/bt_ai_button_text_selector"
                        android:textSize="12sp" />

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_summarize"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_bt_ai_primary_button"
                    android:drawableStart="@drawable/ic_auto_awesome"
                    android:drawablePadding="8dp"
                    android:drawableTint="#FFFFFF"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="48dp"
                    android:paddingHorizontal="24dp"
                    android:text="@string/summarize_button"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- LOADING STATE -->
            <LinearLayout
                android:id="@+id/state_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center"
                android:paddingVertical="32dp"
                android:visibility="gone"
                tools:visibility="gone">

                <ProgressBar
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminateTint="?attr/colorAccent"
                    android:layout_marginBottom="16dp" />

                <org.schabi.newpipe.views.NewPipeTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/summarizing"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <org.schabi.newpipe.views.NewPipeTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Crafting smart insights..."
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <!-- ERROR STATE -->
            <LinearLayout
                android:id="@+id/state_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center"
                android:paddingVertical="24dp"
                android:visibility="gone"
                tools:visibility="gone">

                <org.schabi.newpipe.views.NewPipeTextView
                    android:id="@+id/tv_error_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"
                    android:textSize="14sp"
                    android:textColor="@android:color/holo_red_light"
                    tools:text="Failed to summarize: Network error" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_bt_ai_action_button"
                    android:drawableStart="@drawable/ic_refresh"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/bt_switch_on_color"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="48dp"
                    android:paddingHorizontal="24dp"
                    android:text="@string/retry"
                    android:textAllCaps="false"
                    android:textColor="@color/bt_ai_button_text_selector"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SUCCESS STATE / RESULTS -->
            <LinearLayout
                android:id="@+id/state_success"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="gone">

                <!-- Summary Bullets Card (12dp corner radius) -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <org.schabi.newpipe.views.NewPipeTextView
                            android:id="@+id/tv_summary_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="15sp"
                            android:lineSpacingExtra="6sp"
                            android:lineSpacingMultiplier="1.2"
                            android:textColor="#FFFFFF"
                            tools:text="• Bullet point number one.\n• Bullet point number two.\n• Bullet point number three." />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Action Button Bar (Copy + Refresh Aligned) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end|center_vertical"
                    android:layout_marginTop="16dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_copy_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_bt_ai_action_button"
                        android:drawableStart="@drawable/ic_content_copy"
                        android:drawablePadding="8dp"
                        android:drawableTint="#FFFFFF"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="48dp"
                        android:paddingHorizontal="16dp"
                        android:text="Copy"
                        android:contentDescription="Copy summary to clipboard"
                        android:textAllCaps="false"
                        android:textColor="@color/bt_ai_button_text_selector"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_re_summarize"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_bt_ai_action_button"
                        android:drawableStart="@drawable/ic_refresh"
                        android:drawablePadding="8dp"
                        android:drawableTint="#FFFFFF"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="48dp"
                        android:paddingHorizontal="16dp"
                        android:text="Refresh"
                        android:contentDescription="Refresh and regenerate summary"
                        android:textAllCaps="false"
                        android:textColor="@color/bt_ai_button_text_selector"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

        <!-- TALK TO VIDEO Q&A BAR (ALWAYS VISIBLE, 8DP GRID ALIGNED) -->
        <LinearLayout
            android:id="@+id/layout_ask_video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_ai_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <EditText
                android:id="@+id/et_ask_video"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Ask AI about this video..."
                android:imeOptions="actionSend"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_send_ask"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_bt_ai_action_button"
                android:drawableStart="@drawable/ic_send"
                android:drawablePadding="6dp"
                android:drawableTint="?attr/colorAccent"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingHorizontal="16dp"
                android:text="Ask"
                android:contentDescription="Send question to AI"
                android:textAllCaps="false"
                android:textColor="@color/bt_ai_button_text_selector"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
