<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/dark_dialog_background_color"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Edit Prompt"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/prompt_editor_title_hint"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_prompt_editor_title"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_ai_input"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorSecondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Short description (optional)"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_prompt_editor_desc"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_ai_input"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:maxLines="2"
            android:padding="12dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorSecondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Category"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp" />

        <AutoCompleteTextView
            android:id="@+id/spinner_prompt_category"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_ai_input"
            android:inputType="none"
            android:paddingHorizontal="12dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorSecondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/prompt_editor_body_hint"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_prompt_editor_body"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_ai_input"
            android:fontFamily="monospace"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_editor_cancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_ai_chip"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingHorizontal="20dp"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_editor_save"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_bt_ai_primary_button"
                android:drawableStart="@drawable/ic_done"
                android:drawablePadding="6dp"
                android:drawableTint="#FFFFFF"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="48dp"
                android:paddingHorizontal="24dp"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
